<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>To-Do List Preview</title>
</head>
<body>
    <svg width="400" height="500" xmlns="http://www.w3.org/2000/svg">
        <rect width="400" height="500" fill="#f5f3f0"/>
        <text x="20" y="40" font-size="24" font-weight="bold" fill="#1a1f3a">To-Do List</text>
        <line x1="20" y1="60" x2="380" y2="60" stroke="#1a1f3a" stroke-width="2"/>
        <circle cx="30" cy="90" r="5" fill="white" stroke="#1a1f3a" stroke-width="2"/>
        <text x="50" y="95" font-size="12" fill="#1a1f3a">Task 1</text>
        <circle cx="30" cy="125" r="5" fill="#b5e18b" stroke="#1a1f3a" stroke-width="2"/>
        <text x="50" y="130" font-size="12" fill="#1a1f3a">Task 2</text>
        <circle cx="30" cy="160" r="5" fill="white" stroke="#1a1f3a" stroke-width="2"/>
        <text x="50" y="165" font-size="12" fill="#1a1f3a">Task 3</text>
        <circle cx="30" cy="195" r="5" fill="white" stroke="#1a1f3a" stroke-width="2"/>
        <text x="50" y="200" font-size="12" fill="#1a1f3a">Task 4</text>
        <circle cx="30" cy="230" r="5" fill="#b5e18b" stroke="#1a1f3a" stroke-width="2"/>
        <text x="50" y="235" font-size="12" fill="#1a1f3a">Task 5</text>
    </svg>
</body>
</html>
