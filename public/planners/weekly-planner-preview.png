<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Weekly Planner Preview</title>
</head>
<body>
    <svg width="400" height="500" xmlns="http://www.w3.org/2000/svg">
        <rect width="400" height="500" fill="#f5f3f0"/>
        <text x="20" y="40" font-size="24" font-weight="bold" fill="#1a1f3a">Weekly Planner</text>
        <line x1="20" y1="60" x2="380" y2="60" stroke="#1a1f3a" stroke-width="2"/>
        <text x="20" y="90" font-size="11" fill="#1a1f3a" font-weight="bold">Mon | Tue | Wed | Thu | Fri | Sat | Sun</text>
        <rect x="20" y="110" width="360" height="30" fill="white" stroke="#1a1f3a" stroke-width="1"/>
        <rect x="20" y="150" width="360" height="30" fill="white" stroke="#1a1f3a" stroke-width="1"/>
        <rect x="20" y="190" width="360" height="30" fill="white" stroke="#1a1f3a" stroke-width="1"/>
        <text x="20" y="240" font-size="12" fill="#1a1f3a" font-weight="bold">Weekly Goals</text>
        <rect x="20" y="260" width="360" height="80" fill="white" stroke="#1a1f3a" stroke-width="1"/>
    </svg>
</body>
</html>
