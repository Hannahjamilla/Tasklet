<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Daily Planner Preview</title>
</head>
<body>
    <svg width="400" height="500" xmlns="http://www.w3.org/2000/svg">
        <rect width="400" height="500" fill="#f5f3f0"/>
        <text x="20" y="40" font-size="24" font-weight="bold" fill="#1a1f3a">Daily Planner</text>
        <line x1="20" y1="60" x2="380" y2="60" stroke="#1a1f3a" stroke-width="2"/>
        <text x="20" y="90" font-size="12" fill="#1a1f3a">Morning</text>
        <rect x="20" y="100" width="360" height="40" fill="white" stroke="#1a1f3a" stroke-width="1"/>
        <text x="20" y="150" font-size="12" fill="#1a1f3a">Afternoon</text>
        <rect x="20" y="160" width="360" height="40" fill="white" stroke="#1a1f3a" stroke-width="1"/>
        <text x="20" y="210" font-size="12" fill="#1a1f3a">Evening</text>
        <rect x="20" y="220" width="360" height="40" fill="white" stroke="#1a1f3a" stroke-width="1"/>
        <text x="20" y="280" font-size="12" fill="#1a1f3a" font-weight="bold">Notes & Reflections</text>
        <rect x="20" y="300" width="360" height="100" fill="white" stroke="#1a1f3a" stroke-width="1"/>
    </svg>
</body>
</html>
