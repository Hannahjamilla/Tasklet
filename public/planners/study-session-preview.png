<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Study Session Log Preview</title>
</head>
<body>
    <svg width="400" height="500" xmlns="http://www.w3.org/2000/svg">
        <rect width="400" height="500" fill="#f5f3f0"/>
        <text x="20" y="40" font-size="24" font-weight="bold" fill="#1a1f3a">Study Session Log</text>
        <line x1="20" y1="60" x2="380" y2="60" stroke="#1a1f3a" stroke-width="2"/>
        <text x="20" y="90" font-size="11" fill="#1a1f3a">Subject | Duration | Effectiveness</text>
        <rect x="20" y="110" width="360" height="30" fill="white" stroke="#1a1f3a" stroke-width="1"/>
        <rect x="20" y="150" width="360" height="30" fill="white" stroke="#1a1f3a" stroke-width="1"/>
        <rect x="20" y="190" width="360" height="30" fill="white" stroke="#1a1f3a" stroke-width="1"/>
        <rect x="20" y="230" width="360" height="30" fill="white" stroke="#1a1f3a" stroke-width="1"/>
        <text x="20" y="290" font-size="12" fill="#1a1f3a" font-weight="bold">Notes</text>
        <rect x="20" y="310" width="360" height="60" fill="white" stroke="#1a1f3a" stroke-width="1"/>
    </svg>
</body>
</html>
